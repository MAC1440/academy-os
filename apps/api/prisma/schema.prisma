generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ADMIN
  STAFF
  LEARNER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

enum StaffType {
  TEACHER
  ADMINISTRATIVE
  SUPPORT
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
}

enum AcademicOfferingType {
  SCHOOL_CLASS
  COURSE
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  email     String?
  phone     String?
  address   String?
  timezone  String   @default("Asia/Karachi")
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  roles     Role[]
  audits    AuditLog[]
  sharedNotes SharedNote[]
  kioskSettings AttendanceKioskSettings?
  schoolClasses SchoolClass[]
  courses     Course[]
  subjects    Subject[]
  admissionApplications AdmissionApplication[]
}

model User {
  id                   String        @id @default(cuid())
  accountType          AccountType
  username             String?       @unique
  contactNumber        String?
  fullName             String
  email                String?
  passwordHash         String
  pinHash              String?
  mustCompleteProfile  Boolean       @default(true)
  status               AccountStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  roleAssignments      RoleAssignment[]
  staffProfile         StaffProfile?
  audits               AuditLog[]    @relation("AuditActor")
  createdNotes         SharedNote[]  @relation("SharedNoteAuthor")
  guardianStudents     Student[]     @relation("GuardianPortalStudent")

  @@index([accountType, status])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String
  addressKey     String
  city           String?
  phone          String?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  operatingHours BranchOperatingHour[]
  roleAssignments RoleAssignment[]
  staffAttendance StaffAttendance[]
  academicOfferings AcademicOffering[]
  admissionApplications AdmissionApplication[]
  students Student[]

  @@unique([organizationId, addressKey])
  @@index([status])
}

model BranchOperatingHour {
  id        String       @id @default(cuid())
  branchId  String
  label     String
  opensAt   String
  closesAt  String
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, label])
}

model StaffProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  staffType   StaffType @default(TEACHER)
  designation String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance  StaffAttendance[]
  academicOfferingAssignments AcademicOfferingTeacher[]

  @@index([staffType])
}

model SchoolClass {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  sortOrder       Int          @default(0)
  sectionsEnabled Boolean      @default(false)
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicOfferings AcademicOffering[]

  @@unique([organizationId, name])
  @@index([organizationId, status, sortOrder])
}

model Course {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicOfferings AcademicOffering[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model Subject {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  code            String?
  status          EntityStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academicOfferings AcademicOfferingSubject[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model AcademicOffering {
  id              String               @id @default(cuid())
  branchId        String
  offeringType    AcademicOfferingType
  schoolClassId   String?
  courseId        String?
  sectionName     String?
  offeringKey     String
  status          EntityStatus         @default(ACTIVE)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  schoolClass     SchoolClass?         @relation(fields: [schoolClassId], references: [id], onDelete: Restrict)
  course          Course?              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  subjects        AcademicOfferingSubject[]
  teachers        AcademicOfferingTeacher[]
  admissionApplications AdmissionApplication[]
  students        Student[]

  @@unique([branchId, offeringKey])
  @@index([branchId, status])
}

model AcademicOfferingSubject {
  academicOfferingId String
  subjectId          String
  academicOffering   AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)
  subject            Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([academicOfferingId, subjectId])
}

model AcademicOfferingTeacher {
  academicOfferingId String
  staffProfileId     String
  academicOffering   AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)
  staffProfile       StaffProfile     @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)

  @@id([academicOfferingId, staffProfileId])
}

model AdmissionApplication {
  id                    String          @id @default(cuid())
  organizationId        String
  branchId              String
  academicOfferingId    String
  studentFullName       String
  studentCnic           String
  guardianFullName      String
  guardianContactNumber String
  previousSchool        String?
  previousPerformance   String?
  status                AdmissionStatus @default(PENDING)
  reviewNote            String?
  reviewedAt            DateTime?
  reviewedByUserId      String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  academicOffering      AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Restrict)
  student               Student?

  @@unique([academicOfferingId, studentCnic])
  @@index([branchId, status])
  @@index([organizationId, status])
}

model Student {
  id                    String   @id @default(cuid())
  admissionApplicationId String @unique
  guardianPortalUserId  String
  branchId              String
  academicOfferingId    String
  studentFullName       String
  studentCnic           String
  guardianFullName      String
  guardianContactNumber String
  previousSchool        String?
  previousPerformance   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?
  admissionApplication  AdmissionApplication @relation(fields: [admissionApplicationId], references: [id], onDelete: Restrict)
  guardianPortalUser    User     @relation("GuardianPortalStudent", fields: [guardianPortalUserId], references: [id], onDelete: Restrict)
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  academicOffering      AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Restrict)

  @@unique([academicOfferingId, studentCnic])
  @@index([guardianPortalUserId])
  @@index([branchId])
}

model AttendanceKioskSettings {
  id                String    @id @default(cuid())
  organizationId    String    @unique
  defaultStaffShiftStart String    @default("07:00")
  defaultStaffShiftEnd   String    @default("14:00")
  graceMinutes      Int       @default(15)
  workingDays       Weekday[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model StaffAttendance {
  id              String                @id @default(cuid())
  staffProfileId  String
  branchId        String
  attendanceDate  DateTime              @db.Date
  checkInAt       DateTime
  checkOutAt      DateTime?
  status          StaffAttendanceStatus
  overrideReason  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  staffProfile    StaffProfile          @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, attendanceDate])
  @@index([branchId, attendanceDate])
}

model SharedNote {
  id          String   @id @default(cuid())
  organizationId String
  authorUserId String
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author      User     @relation("SharedNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, deletedAt])
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  group String
  label String
  roles RolePermission[]
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  assignments    RoleAssignment[]
  @@unique([organizationId, name])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  branchId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId, branchId])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         AuditAction
  entityType     String
  entityId       String
  changes        Json?
  createdAt      DateTime    @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
}
