generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  ADMIN
  STAFF
  LEARNER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}

enum StaffType {
  TEACHER
  ADMINISTRATIVE
  SUPPORT
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StaffAttendanceStatus {
  PRESENT
  LATE
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  email     String?
  phone     String?
  address   String?
  timezone  String   @default("Asia/Karachi")
  currency  String   @default("PKR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  roles     Role[]
  audits    AuditLog[]
  kioskSettings AttendanceKioskSettings?
}

model User {
  id                   String        @id @default(cuid())
  accountType          AccountType
  username             String?       @unique
  contactNumber        String?       @unique
  fullName             String
  email                String?
  passwordHash         String
  pinHash              String?
  mustCompleteProfile  Boolean       @default(true)
  status               AccountStatus @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  roleAssignments      RoleAssignment[]
  staffProfile         StaffProfile?
  audits               AuditLog[]    @relation("AuditActor")

  @@index([accountType, status])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String
  addressKey     String
  city           String?
  phone          String?
  status         EntityStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions       Session[]
  roleAssignments RoleAssignment[]
  staffAttendance StaffAttendance[]

  @@unique([organizationId, addressKey])
  @@index([status])
}

model Session {
  id        String       @id @default(cuid())
  branchId  String
  name      String
  startsAt  String
  endsAt    String
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, name])
}

model StaffProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  staffType   StaffType @default(TEACHER)
  designation String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance  StaffAttendance[]

  @@index([staffType])
}

model AttendanceKioskSettings {
  id                String    @id @default(cuid())
  organizationId    String    @unique
  defaultShiftStart String    @default("07:00")
  defaultShiftEnd   String    @default("14:00")
  graceMinutes      Int       @default(15)
  workingDays       Weekday[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model StaffAttendance {
  id              String                @id @default(cuid())
  staffProfileId  String
  branchId        String
  attendanceDate  DateTime              @db.Date
  checkInAt       DateTime
  checkOutAt      DateTime?
  status          StaffAttendanceStatus
  overrideReason  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  staffProfile    StaffProfile          @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, attendanceDate])
  @@index([branchId, attendanceDate])
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  group String
  label String
  roles RolePermission[]
}

model Role {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  assignments    RoleAssignment[]
  @@unique([organizationId, name])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  branchId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId, branchId])
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         AuditAction
  entityType     String
  entityId       String
  changes        Json?
  createdAt      DateTime    @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
}
