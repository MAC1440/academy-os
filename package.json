{
  "name": "academy-os",
  "version": "0.0.1",
  "private": true,
  "description": "AcademyOS Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "web": "npm run dev --workspace=apps/web -- -p 3001",
    "api": "npm run start:dev --workspace=apps/api -- --port 3000",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "project": "npm run docker:up && concurrently -k -n WEB,API -c blue,green \"npm run web\" \"npm run api\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
